alias sd "$HOME/termux-dotfiles/setup.sh --sync" # sync dotfiles
alias snf "$HOME/scripts/sync-all.sh --force-local" #sync notes y keepass forced local
alias sne "$HOME/scripts/sync-all.sh --force-external" # forced external notes y keepass
alias sa "$HOME/scripts/sync-all.sh" #sync normal
alias startssh "$HOME/scripts/startssh.sh"
alias clc "clear"
alias gs "cd $HOME/obsidian && git status && cd -"
alias cerrar "pkill -f ssh || true; exit"
alias help-config "cat ~/termux-dotfiles/help_config.md"
